# ---------------------------------------------------------------
# Creative Studio の設定
#
# このファイルを .env.local にコピーして、使うものだけ埋めてください。
# .env.local は git に入りません。
#   cp .env.local.example .env.local
# ---------------------------------------------------------------

# ---------------------------------------------------------------
# OpenAI（必須）
# ---------------------------------------------------------------
# ストーリー・ネーム（コマ割り）・セリフの生成に使います。
# 画像を Hugging Face で作る場合でも、ここは必要です。
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# 使うモデル。未設定なら下の既定値になります
# OPENAI_TEXT_MODEL=gpt-5.5
# OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_VISION_MODEL=gpt-5.5

# ---------------------------------------------------------------
# Hugging Face（単行本の画像生成）
# ---------------------------------------------------------------
# npm run generate manga の画像生成に使います（既定の生成元）。
# 無料で取得できます: https://huggingface.co/settings/tokens
# 「Read」権限で足ります。
HUGGINGFACE_API_KEY=

# 使うモデル。未設定なら SDXL
# HUGGINGFACE_MODEL=stabilityai/stable-diffusion-xl-base-1.0

# エンドポイントの土台。従来形式に戻すなら
#   https://api-inference.huggingface.co/models
# HUGGINGFACE_BASE_URL=https://router.huggingface.co/hf-inference/models

# 生成の細かい設定（未設定なら下の既定値）
# HUGGINGFACE_TIMEOUT_MS=180000
# HUGGINGFACE_STEPS=28
# HUGGINGFACE_GUIDANCE_SCALE=7
# HUGGINGFACE_NEGATIVE_PROMPT=lowres, bad anatomy, bad hands, text, watermark, signature, blurry, jpeg artifacts

# ---------------------------------------------------------------
# Supabase（任意）
# ---------------------------------------------------------------
# Web 画面から小説・シリーズを保存するときだけ使います。
# CLI（npm run generate）だけ使うなら不要です。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------
# ほかの画像生成サービス（任意・グラビアモード用）
# ---------------------------------------------------------------
STABILITY_API_KEY=
# STABILITY_MODEL=core

PRODIA_TOKEN=
# PRODIA_JOB_TYPE=inference.flux-2.dev.txt2img.v1

# ---------------------------------------------------------------
# その他
# ---------------------------------------------------------------
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# true にすると画像生成 API を呼ばずに画面の動きだけ確かめられます（Web 画面用）
# NEXT_PUBLIC_USE_STUB=false
