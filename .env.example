# =============================================================
# Creative Studio - 環境変数テンプレート（公開用）
# =============================================================
# このファイルは Git にコミットします。実際のキーは書かないこと。
#   cp .env.example .env.local
# としてから .env.local に値を入れてください。
# -------------------------------------------------------------

# --- Supabase（認証 / データベース）-----------------------------
# ダッシュボード > Project Settings > API から取得
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# サーバー側専用。絶対に NEXT_PUBLIC_ を付けないこと（全権限キー）
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenAI（DALL-E 画像生成）----------------------------------
# https://platform.openai.com/api-keys から取得。サーバー側専用。
OPENAI_API_KEY=
# 使用モデル（dall-e-3 / dall-e-2）
OPENAI_IMAGE_MODEL=dall-e-3

# --- アプリ設定 -------------------------------------------------
# 認証コールバックやリダイレクトの基準 URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# NODE_ENV は Next.js が自動で設定するため、ここでは指定しません
# （dev は development、build/start は production）
