# =============================================================
# Creative Studio - 環境変数テンプレート（公開用）
# =============================================================
# このファイルは Git にコミットします。実際のキーは書かないこと。
#   cp .env.example .env.local
# としてから .env.local に値を入れてください。
# -------------------------------------------------------------

# --- OpenAI（ストーリー・ネーム・セリフの生成）------------------
# https://platform.openai.com/api-keys から取得。サーバー側専用。
# 画像を Hugging Face で作る場合でも、ここは必要です。
OPENAI_API_KEY=

# 本文・ネーム生成に使うモデル
OPENAI_TEXT_MODEL=gpt-5.5

# 画像生成に使うモデル（--backend=openai のときだけ）
OPENAI_IMAGE_MODEL=gpt-image-1

# 画像を見て判断させるとき用（人物が写っているかの判定など）。
# 未設定なら OPENAI_TEXT_MODEL を使う
OPENAI_VISION_MODEL=

# --- Hugging Face（単行本の画像生成・既定）----------------------
# https://huggingface.co/settings/tokens から取得（Read 権限で足ります）。
# npm run generate manga の画像生成に使います。
HUGGINGFACE_API_KEY=

# 使うモデル。未設定なら SDXL
HUGGINGFACE_MODEL=stabilityai/stable-diffusion-xl-base-1.0

# エンドポイントの土台。従来形式に戻すなら
#   https://api-inference.huggingface.co/models
HUGGINGFACE_BASE_URL=https://router.huggingface.co/hf-inference/models

# 生成の細かい設定
HUGGINGFACE_TIMEOUT_MS=180000
HUGGINGFACE_STEPS=28
HUGGINGFACE_GUIDANCE_SCALE=7
HUGGINGFACE_NEGATIVE_PROMPT=lowres, bad anatomy, bad hands, text, watermark, signature, blurry, jpeg artifacts

# --- Supabase（Web 画面で小説を保存するときだけ）----------------
# ダッシュボード > Project Settings > API から取得。
# CLI（npm run generate）だけ使うなら不要です。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# サーバー側専用。絶対に NEXT_PUBLIC_ を付けないこと（全権限キー）
SUPABASE_SERVICE_ROLE_KEY=

# --- Prodia / Stability（グラビアモードの画像生成）--------------
# https://app.prodia.com の API Dashboard から取得。サーバー側専用。
PRODIA_TOKEN=
# 使用する job type。既定は FLUX.2 [dev]
# 一覧: https://docs.prodia.com/reference/inference/
PRODIA_JOB_TYPE=inference.flux-2.dev.txt2img.v1

STABILITY_API_KEY=
STABILITY_MODEL=core

# --- 開発用 -----------------------------------------------------
# true にすると画像生成 API を呼ばず、から回しで通す（Web 画面用）。
# CLI は --stub を使ってください。
NEXT_PUBLIC_USE_STUB=false

# --- アプリ設定 -------------------------------------------------
# 認証コールバックやリダイレクトの基準 URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# NODE_ENV は Next.js が自動で設定するため、ここでは指定しません
# （dev は development、build/start は production）
