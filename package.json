{
  "name": "creative-studio",
  "version": "0.1.0",
  "private": true,
  "description": "漫画・小説統合制作アプリ Creative Studio",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "electron:dev": "concurrently -k \"next dev\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:build": "next build && electron-builder"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.1",
    "@supabase/supabase-js": "^2.45.4",
    "docx": "^9.7.1",
    "fs-extra": "^11.4.0",
    "jimp": "^1.6.1",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "next": "14.2.35",
    "openai": "^4.67.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "server-only": "^0.0.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.5",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "electron-is-dev": "^3.0.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.35",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "wait-on": "^9.1.0"
  },
  "main": "electron/main.js",
  "build": {
    "appId": "com.sawabe.creative-studio",
    "productName": "Creative Studio",
    "files": [
      "electron/**",
      ".next/**",
      "public/**",
      "package.json",
      "next.config.mjs"
    ],
    "asar": false,
    "directories": {
      "output": "dist-electron"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
