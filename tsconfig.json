{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  // gravure-ai-gen は独自の tsconfig を持つ別プロジェクト（Next 16 / React 19）。
  // include の "**/*.tsx" で拾ってしまうと、こちらの React 18 の型と衝突して
  // ルートの typecheck とビルドが落ちる。
  "exclude": ["node_modules", "gravure-ai-gen"]
}
